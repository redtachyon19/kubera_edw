{
  "name": "kubera-edw-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Kubera_EDW dashboard hub — one workspace fronting every dashboard in the warehouse.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:lan": "HUB_HOST=0.0.0.0 node scripts/dev.mjs",
    "dev:web": "node scripts/dev.mjs --web-only",
    "dev:dashboards": "node scripts/dev.mjs --dashboards-only",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
