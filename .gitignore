# --- Secrets & environment ---
.env
*.env
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Raw / landed data (not committed; re-fetchable from source APIs) ---
data/raw/*
!data/raw/.gitkeep

# Backfill request queue — runtime state, rebuilt as companies are asked for
data/backfill_queue.json

# World Bank macro read live by the world desk — a cache, re-fetchable in a minute
data/world_macro_cache.json

# WITS bilateral trade and World Bank trade composition — same story, weekly TTL
data/trade_cache/

# Company logos and country flags, re-fetchable from the icon services
data/image_cache/
*.duckdb
*.duckdb.wal

# --- dbt ---
dbt/target/
dbt/dbt_packages/
dbt/logs/
.user.yml

# --- Dagster ---
# DAGSTER_HOME is the instance directory: run history, event logs and sensor
# cursors, none of which belong in git. `dagster.yaml` is the exception — it is
# the instance's configuration and Dagster requires it to sit inside the same
# directory, which is why it is negated back in rather than kept elsewhere.
tmp_dagster_home/
orchestration/dagster_home/*
!orchestration/dagster_home/dagster.yaml

# --- Dashboard hub (Vite) ---
node_modules/
dashboard_hub/hub/dist/
*.tsbuildinfo

# --- OS / editor / tooling ---
.DS_Store
.idea/
.vscode/
.claude/
*.swp

# Local Postgres cluster — the warehouse itself, never committed.
data/pgdata/
