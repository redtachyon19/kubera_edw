# .env.example — copy to .env and fill in real values; .env itself is gitignored.
# No real secrets belong in this file. The Python clients read these via os.environ
# (python-dotenv loads .env locally); nothing is ever hardcoded in a script.

# --- Free API keys (all free to obtain) ---
FRED_API_KEY=your_fred_key_here
# Required for daily prices: stooq.com now gates its CSV endpoint behind a JS bot check,
# so Alpha Vantage is the price backend. ~25 requests/day covers our 10 tickers with caching.
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# --- Optional: price backend ("alpha_vantage" default, or "stooq" if it ever un-gates) ---
# PRICES_BACKEND=alpha_vantage

# --- SEC EDGAR requires a descriptive User-Agent identifying the requester ---
# Format recommended by SEC: "Sample Company Name AdminContact@example.com"
SEC_EDGAR_USER_AGENT=Kubera EDW Portfolio Project you@example.com

# --- Warehouse: hosted Postgres (Neon) ---
# From your Neon dashboard's connection string:
#   postgresql://<USER>:<PASSWORD>@<HOST>/<DB>?sslmode=require
# Split it into the parts below. Never commit real values — .env is gitignored.
POSTGRES_USER=your_neon_user
POSTGRES_PASSWORD=your_neon_password
POSTGRES_DB=kubera_edw
POSTGRES_HOST=ep-xxxx-xxxx.us-east-2.aws.neon.tech
POSTGRES_PORT=5432
PGSSLMODE=require

# --- Local dev warehouse (DuckDB) ---
# Resolved relative to where you invoke dbt (the dbt/ directory), hence the leading "../".
# Use an absolute path if you run dbt from elsewhere. scripts/bootstrap.sh writes an
# absolute path into your local .env automatically.
DUCKDB_PATH=../data/kubera_edw.duckdb
