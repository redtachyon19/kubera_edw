# .env.example — copy to .env and fill in real values; .env itself is gitignored.
# No real secrets belong in this file. The Python clients read these via os.environ
# (python-dotenv loads .env locally); nothing is ever hardcoded in a script.

# --- Free API keys (all free to obtain) ---
FRED_API_KEY=your_fred_key_here
# Required for daily prices: stooq.com now gates its CSV endpoint behind a JS bot check,
# so Alpha Vantage is the price backend. ~25 requests/day covers our 10 tickers with caching.
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# --- Optional: price backend ("alpha_vantage" default, or "stooq" if it ever un-gates) ---
# PRICES_BACKEND=alpha_vantage

# --- SEC EDGAR requires a descriptive User-Agent identifying the requester ---
# Format recommended by SEC: "Sample Company Name AdminContact@example.com"
SEC_EDGAR_USER_AGENT=Kubera EDW Portfolio Project you@example.com

# --- Optional: US Census trade API key ---
# Free, and only needed past 500 requests per IP per day — the backfill fits under
# that, incremental runs are a handful of calls. https://api.census.gov/data/key_signup.html
# CENSUS_API_KEY=your_census_key_here

# --- Warehouse: Postgres ---
# Defaults below are the local cluster `make db-up` starts in data/pgdata. It is
# loopback-only and holds no secrets, hence a throwaway password and no TLS.
# To promote the warehouse to a real server, point these at it and set
# PGSSLMODE=require — the dbt models and the hub need no other change.
POSTGRES_USER=kubera
POSTGRES_PASSWORD=kubera_local
POSTGRES_DB=kubera_edw
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
PGSSLMODE=disable

# --- Offline CI warehouse (DuckDB) ---
# Only `make demo` uses this: it builds from committed fixtures with no network and
# no server. Everything else runs on Postgres. Resolved relative to the dbt/ directory,
# hence the leading "../"; scripts/bootstrap.sh writes an absolute path automatically.
DUCKDB_PATH=../data/kubera_edw.duckdb
